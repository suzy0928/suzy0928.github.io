---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Suzy Park | Research Portfolio">
  <main class="container">
    <header class="header">
      <span>SYS://SUZY_PORTFOLIO</span>
      <span class="status">● ONLINE</span>
    </header>

    <section class="hero">
      <p class="label">[ RESEARCH INTERFACE / 001 ]</p>

      <h1>SUJI PARK<span></span></h1>

      <p class="subtitle">
        CYBERSECURITY with AI
      </p>

      <nav class="menu">
        <a href="#about">01 / ABOUT ↗</a>
        <a href="#research">02 / RESEARCH ↗</a>
        <a href="/publications/">03 / PUBLICATIONS ↗</a>
        <a href="#projects">04 / PROJECTS ↗</a>
      </nav>
    </section>

    <section id="about" class="content-section">
      <h2>01 / ABOUT</h2>
      <p>Master's Student in Cybersecurity.</p>
    </section>

    <section id="research" class="content-section">
      <h2>02 / RESEARCH</h2>
      <p>AI Security & Adaptive Systems.</p>
    </section>

    <section id="publications" class="content-section">
      <h2>03 / PUBLICATIONS</h2>
      <p>Coming soon.</p>
    </section>

    <section id="projects" class="content-section">
      <h2>04 / PROJECTS</h2>
      <p>Coming soon.</p>
    </section>
  </main>
</BaseLayout>

<style>
  .container {
    max-width: 1100px;
    margin: auto;
    padding: 28px;
  }

  .header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 20px;
    border-bottom: 1px solid #35515b;
    color: var(--muted);
    font-size: 12px;
  }

  .status, .label, h1 span {
    color: var(--accent);
  }

  .hero {
    min-height: 76vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .label {
    font-size: 12px;
    letter-spacing: 2px;
  }

  h1 {
    font-size: clamp(52px, 10vw, 120px);
    letter-spacing: -3px;
    margin: 24px 0;
    text-shadow: 0 0 18px #70e4d044;
  }

  .subtitle {
    color: var(--muted);
    letter-spacing: 2px;
    line-height: 1.8;
  }

  .menu {
    display: grid;
    gap: 12px;
    margin-top: 48px;
    max-width: 500px;
  }

  .menu a {
    color: var(--text);
    text-decoration: none;
    padding: 16px;
    background: var(--panel);
    border: 1px solid #35515b;
    transition: color 0.2s, border-color 0.2s;
  }

  .menu a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .content-section {
    min-height: 35vh;
    padding: 60px 0;
    border-top: 1px solid #35515b;
    scroll-margin-top: 24px;
  }

  .content-section h2 {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .container { padding: 18px; }
    .header { font-size: 9px; }
    h1 { letter-spacing: -1px; }
    .subtitle { font-size: 12px; }
  }
</style>