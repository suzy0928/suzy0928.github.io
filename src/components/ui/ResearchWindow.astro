<dialog id="research-dialog" class="research-dialog" aria-labelledby="dialog-title" aria-describedby="dialog-description">
  <div class="window-frame" data-augmented-ui="border tl-clip br-clip">
    <div class="window-titlebar">
      <span>ARCHIVE://LATEST_PUBLICATION</span>
      <form method="dialog"><button class="window-close" aria-label="Close research record">×</button></form>
    </div>
    <div class="window-body">
      <p class="eyebrow">JOURNAL RECORD / 2026</p>
      <h2 id="dialog-title">GRIV</h2>
      <p id="dialog-description" class="paper-name">Gateway-Based Report Integrity Verification against Report Concealment Attacks in Distributed IoT IDS</p>
      <p class="paper-meta">S. Park, Y. Lee, and I.-G. Lee</p>
      <p class="paper-meta"><em>Computers, Materials &amp; Continua</em>, 2026</p>
      <div class="window-actions">
        <a href="https://doi.org/10.32604/cmc.2026.092071" target="_blank" rel="noopener noreferrer">OPEN DOI ↗</a>
        <a href="/publications/">ALL PUBLICATIONS ↗</a>
      </div>
    </div>
  </div>
</dialog>

<style>
  .research-dialog {
    width: min(92vw, 620px);
    max-height: min(90dvh, 740px);
    padding: 0;
    color: #e5f5e7;
    background: transparent;
    border: 0;
    overflow: auto;
  }
  .research-dialog::backdrop { background: rgba(0, 5, 3, .78); backdrop-filter: blur(5px); }
  .window-frame {
    --aug-border-all: 1px;
    --aug-border-bg: #79e99b;
    --aug-tl: 17px;
    --aug-br: 17px;
    background: #07140ddf;
  }
  .window-titlebar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 12px 18px; border-bottom: 1px solid #315640; color: #86e9a1; font-size: 11px; letter-spacing: .08em; }
  .window-titlebar form { margin: 0; }
  .window-close { border: 1px solid #548961; background: transparent; color: #d7f7df; width: 32px; height: 32px; cursor: pointer; font-size: 20px; }
  .window-close:hover, .window-close:focus-visible { background: #214a2e; }
  .window-body { padding: clamp(20px, 4vw, 34px); }
  .eyebrow { font-size: 11px; letter-spacing: .12em; color: #86e9a1; }
  h2 { font-size: clamp(32px, 6vw, 56px); margin: 12px 0; }
  .paper-name { font-size: clamp(16px, 2.4vw, 20px); line-height: 1.6; }
  .paper-meta { font-size: 13px; line-height: 1.7; color: #b6cbbb; }
  .window-actions { display: flex; gap: 12px 22px; flex-wrap: wrap; margin-top: 30px; }
  .window-actions a { color: #a0ffb7; text-decoration: none; border-bottom: 1px solid currentColor; font-size: 12px; padding-bottom: 5px; }
  a:focus-visible, button:focus-visible { outline: 2px solid #b7ffd0; outline-offset: 3px; }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#research-dialog');
  if (dialog) {
    document.querySelectorAll<HTMLButtonElement>('[data-open-research]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!dialog.open) dialog.showModal();
      });
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
