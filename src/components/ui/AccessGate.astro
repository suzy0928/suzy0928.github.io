<dialog id="access-gate" class="access-gate" aria-labelledby="gate-title" aria-describedby="gate-desc">
  <section class="gate-frame" data-augmented-ui="border tl-clip br-clip">
    <div class="gate-bar"><span>ACCESS_PROTOCOL // PUBLIC DEMO</span><span aria-hidden="true">[ ? ]</span></div>
    <div class="gate-content">
      <p class="gate-kicker">[ NOTICE / RESEARCH ARCHIVE ]</p>
      <h2 id="gate-title">REQUESTING ACCESS<span class="gate-caret">_</span></h2>
      <p id="gate-desc">You have reached the experimental interface of Su-ji Park's research archive. The classified aesthetic is intentional. The information is not classified.</p>
      <p class="gate-note">Prefer a conventional, no-surprises academic profile? The official-looking version is one click away.</p>
      <div class="gate-choices">
        <a class="gate-official" href="https://sites.google.com/sungshin.ac.kr/suji-park/%ED%99%88?authuser=0">[ OPEN CLASSIC PROFILE ] <span aria-hidden="true">↗</span></a>
        <button class="gate-enter" id="gate-enter" type="button">[ ENTER RESEARCH CONSOLE ] <span aria-hidden="true">↵</span></button>
      </div>
      <p class="gate-footnote">NO CLEARANCE REQUIRED · NO SECRET DATA · JUST A QUESTIONABLE AMOUNT OF GREEN PHOSPHOR.</p>
    </div>
  </section>
</dialog>

<style>
  .access-gate{width:min(92vw,690px);max-height:90dvh;overflow:auto;border:0;padding:0;background:transparent;color:#e6f9e8}
  .access-gate::backdrop{background:rgba(0,4,2,.82);backdrop-filter:blur(7px)}
  .gate-frame{--aug-border-all:1px;--aug-border-bg:#86f4a2;--aug-tl:20px;--aug-br:20px;background:#06110bef;box-shadow:0 0 50px #1ab54d1e}
  .gate-bar{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #3b754e;padding:14px 19px;font-size:11px;letter-spacing:.09em;color:#9bffc0}
  .gate-content{padding:clamp(20px,5vw,40px)}
  .gate-kicker{color:#8afa9e;font-size:11px;letter-spacing:.1em}
  #gate-title{font-size:clamp(26px,5vw,46px);margin:12px 0 20px;line-height:1.2;overflow-wrap:anywhere}
  .gate-caret{color:#8afa9e;animation:gate-blink 1s steps(2) infinite}
  #gate-desc,.gate-note{font-size:14px;line-height:1.85;color:#c0d9c6}
  .gate-note{color:#99c3a4}
  .gate-choices{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:28px 0}
  .gate-choices a,.gate-choices button{display:flex;align-items:center;justify-content:space-between;gap:8px;text-align:left;padding:15px 12px;border:1px solid #4d8560;background:#102319;color:#e3f9e5;font:inherit;font-size:11px;text-decoration:none;cursor:pointer;line-height:1.5}
  .gate-choices .gate-enter{background:#1c4c2a;border-color:#87f4a1}
  .gate-choices a:hover,.gate-choices button:hover{background:#28663a}
  .gate-choices a:focus-visible,.gate-choices button:focus-visible{outline:2px solid #d0ffe0;outline-offset:3px}
  .gate-footnote{font-size:10px;letter-spacing:.02em;line-height:1.7;color:#96aa99}
  @keyframes gate-blink{50%{opacity:0}}
  @media(max-width:560px){.gate-choices{grid-template-columns:1fr}}
  @media(prefers-reduced-motion:reduce){.gate-caret{animation:none}}
</style>

<script>
  const gate = document.querySelector<HTMLDialogElement>('#access-gate');
  const enter = document.querySelector<HTMLButtonElement>('#gate-enter');
  const seenKey = 'suji-research-gate-seen-v1';
  if (gate && enter) {
    let alreadySeen = false;
    try { alreadySeen = sessionStorage.getItem(seenKey) === 'yes'; } catch { /* storage unavailable */ }
    if (!alreadySeen && !gate.open) gate.showModal();
    gate.addEventListener('close', () => {
      try { sessionStorage.setItem(seenKey, 'yes'); } catch { /* storage unavailable */ }
    });
    enter.addEventListener('click', () => gate.close());
    gate.addEventListener('click', (event) => { if (event.target === gate) gate.close(); });
  }
</script>

