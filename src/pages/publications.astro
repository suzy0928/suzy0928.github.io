---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publications } from "../data/publications";

const typeLabels = {
  journal: "JOURNAL",
  international: "INTERNATIONAL CONFERENCE",
  domestic: "DOMESTIC CONFERENCE / WORKSHOP",
};

const typeOrder = {
  journal: 0,
  international: 1,
  domestic: 2,
};

const sorted = [...publications].sort(
  (a, b) =>
    b.year - a.year ||
    typeOrder[a.type] - typeOrder[b.type]
);

const years = [...new Set(sorted.map((p) => p.year))];
---

<BaseLayout title="Publications | Su-ji Park">
  <main class="publications-page">
    <header class="page-header">
      <a href="/">← BACK TO HOME</a>
      <span>RESEARCH ARCHIVE / 002</span>
    </header>

    <h1>PUBLICATIONS<span>_</span></h1>
    <p class="intro">
      Peer-reviewed journal articles,
      international conferences, and workshops.
    </p>

    {years.map((year) => (
      <section class="year-section">
        <h2>[ {year} ]</h2>

        {sorted
          .filter((paper) => paper.year === year)
          .map((paper) => (
            <article class="paper">
              <div class="meta">
                <span>{typeLabels[paper.type]}</span>
                {paper.award && (
                  <span class="award">{paper.award}</span>
                )}
              </div>

              <h3>{paper.title}</h3>

              <p class="authors">
                {paper.authors.map((author, index) => (
                  <span>
                    <span class:list={{
                      "self-author": index === paper.selfIndex
                    }}>
                      {author}
                    </span>
                    {index < paper.authors.length - 1
                      ? index === paper.authors.length - 2
                        ? ", and "
                        : ", "
                      : ""}
                  </span>
                ))}
              </p>

              <p class="venue">
                <em>{paper.venue}</em>, {paper.details}.
              </p>

              {paper.url && (
                <a
                  href={paper.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="paper-link"
                >
                  VIEW PUBLICATION ↗
                </a>
              )}
            </article>
          ))}
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  .publications-page {
    max-width: 1050px;
    margin: 0 auto;
    padding: 40px 24px 100px;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: #9ecca8;
    font-size: 12px;
  }

  a {
    color: #71ff95;
    text-decoration: none;
  }

  h1 {
    margin: 90px 0 12px;
    font-size: clamp(36px, 7vw, 82px);
    overflow-wrap: anywhere;
  }

  h1 span, h2 {
    color: #71ff95;
  }

  .intro {
    color: #aac6b1;
    line-height: 1.8;
  }

  .year-section {
    margin-top: 80px;
  }

  .paper {
    padding: 28px;
    margin-top: 20px;
    border: 1px solid #355943;
    background: rgba(5, 16, 10, .85);
    transition: border-color .2s;
  }

  .paper:hover {
    border-color: #71ff95;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    color: #71ff95;
    font-size: 11px;
    letter-spacing: 1px;
  }

  .award {
    color: #e9d18b;
  }

  h3 {
    font-size: clamp(17px, 2.5vw, 22px);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .authors, .venue {
    line-height: 1.8;
    color: #b6cabb;
  }

  .self-author {
    font-weight: 700;
    color: #eef9f0;
  }

  .paper-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 12px;
  }

  @media (max-width: 600px) {
    .publications-page {
      padding: 24px 16px 70px;
    }

    .page-header {
      font-size: 10px;
    }

    h1 {
      margin-top: 60px;
    }

    .paper {
      padding: 18px;
    }
  }
</style>